; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Demonteks"
config/description="A 2D action platformer where an explorer must fight through alien demons to return to Earth."
config/features=PackedStringArray("4.3", "C#", "Mobile")
boot_splash/bg_color=Color(0.141176, 0.0862745, 0.133333, 1)
boot_splash/image="res://Assets/splash.png"
config/icon="res://icon.png"

[autoload]

GameManager="*res://Scripts/Management/GameManager.cs"
SaveManager="*res://Scripts/Management/SaveManager.cs"
# MobileControls="*res://Scenes/UI/MobileControls.tscn"  # Create this scene later

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/mode=2
window/size/resizable=true
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="Demonteks"

[editor]

movie_writer/movie_file="res://recording.avi"

